# =============================================================================
# SnapLens (C++ Qt6) — .gitignore
# =============================================================================

# ── CMake 构建产物 ──────────────────────────────────────────────────────────
cmake-build-*/
build/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.ninja
.ninja_*
compile_commands.json

# ── 发布产物 ────────────────────────────────────────────────────────────────
dist*/
dist/
dist-static/

# ── tesseract SDK（编译+运行依赖，不入库，需自行准备）──────────────────────────
sdk/tesseract/

# ── 编译中间文件 ────────────────────────────────────────────────────────────
*.obj
*.o
*.pdb
*.ilk
*.exp
*.iobj
*.ipdb
*.tlog

# ── IDE / 编辑器 ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
CMakeLists.txt.user
CMakeLists.txt.user.*
*.user
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# ── WorkBuddy 项目数据（本地记忆/配置，不入库）──────────────────────────────
.workbuddy/

# ── 运行时生成 ──────────────────────────────────────────────────────────────
temp/
*.log

# ── Python 残留（若混入）───────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# ── 系统文件 ────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
