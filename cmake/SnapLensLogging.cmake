# 固定 SDK 源码版本，离线构建；不改变 Qt/OCR 的链接选择。
set(SNAPLENS_SPDLOG_DIR "${PROJECT_SOURCE_DIR}/sdk/spdlog" CACHE PATH "spdlog 1.17.0 源码目录")
if(NOT EXISTS "${SNAPLENS_SPDLOG_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "缺少 spdlog SDK。运行：git clone --depth 1 --branch v1.17.0 https://github.com/gabime/spdlog.git sdk/spdlog")
endif()

function(snaplens_add_logging)
    set(CMAKE_AUTOMOC OFF)
    set(CMAKE_AUTOUIC OFF)
    set(CMAKE_AUTORCC OFF)
    # 在创建第三方目标前指定 CRT；仅对 SnapLens 设置属性不会传递给依赖。
    set(CMAKE_MSVC_RUNTIME_LIBRARY "${SNAPLENS_MSVC_RUNTIME}$<$<CONFIG:Debug>:Debug>")
    set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_ALL OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_EXAMPLE_HO OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_TESTS_HO OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_BENCH OFF CACHE BOOL "" FORCE)
    set(SPDLOG_INSTALL OFF CACHE BOOL "" FORCE)
    set(SPDLOG_FMT_EXTERNAL OFF CACHE BOOL "" FORCE)
    set(SPDLOG_FMT_EXTERNAL_HO OFF CACHE BOOL "" FORCE)
    set(SPDLOG_USE_STD_FORMAT OFF CACHE BOOL "" FORCE)
    set(SPDLOG_WCHAR_FILENAMES ON CACHE BOOL "" FORCE)
    add_subdirectory("${SNAPLENS_SPDLOG_DIR}" "${PROJECT_BINARY_DIR}/sdk/spdlog" EXCLUDE_FROM_ALL)
    get_target_property(_spdlog_version spdlog VERSION)
    if(NOT _spdlog_version VERSION_EQUAL "1.17.0")
        message(FATAL_ERROR "需要 spdlog 1.17.0，当前 SDK 为 ${_spdlog_version}")
    endif()

    add_library(SnapLensLogging STATIC
        "${PROJECT_SOURCE_DIR}/src/log/log_manager.cpp"
        "${PROJECT_SOURCE_DIR}/src/log/log_manager.h")
    target_include_directories(SnapLensLogging PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(SnapLensLogging PUBLIC Qt6::Core PRIVATE spdlog::spdlog)
    target_compile_definitions(SnapLensLogging PUBLIC QT_MESSAGELOGCONTEXT)
    if(MSVC)
        target_compile_options(SnapLensLogging PRIVATE /utf-8 /W4 /permissive-)
        target_compile_definitions(SnapLensLogging PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
endfunction()

snaplens_add_logging()

option(SNAPLENS_BUILD_TESTS "构建日志回归测试（不复制到发布目录）" OFF)
if(SNAPLENS_BUILD_TESTS)
    enable_testing()
    add_executable(SnapLensLoggingTests "${PROJECT_SOURCE_DIR}/tests/log_manager_tests.cpp")
    set_target_properties(SnapLensLoggingTests PROPERTIES AUTOMOC OFF AUTOUIC OFF AUTORCC OFF)
    target_link_libraries(SnapLensLoggingTests PRIVATE SnapLensLogging)
    if(MSVC)
        target_compile_options(SnapLensLoggingTests PRIVATE /utf-8 /W4)
        set_property(TARGET SnapLensLoggingTests PROPERTY MSVC_RUNTIME_LIBRARY
            "${SNAPLENS_MSVC_RUNTIME}$<$<CONFIG:Debug>:Debug>")
    endif()
    add_test(NAME logging COMMAND SnapLensLoggingTests)
endif()
